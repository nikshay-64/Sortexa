<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Surface Brushes -->
    <SolidColorBrush x:Key="BrushBackground" Color="#F3F6FC" />
    <SolidColorBrush x:Key="BrushSecondaryBackground" Color="#EAF0FA" />
    <SolidColorBrush x:Key="BrushElevatedSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushCardSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushHoverSurface" Color="#E2ECFA" />
    <SolidColorBrush x:Key="BrushActiveSurface" Color="#D5E4F8" />
    <SolidColorBrush x:Key="BrushInputBackground" Color="#F7F9FD" />
    <SolidColorBrush x:Key="BrushInputBorder" Color="#CDD8EC" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="BrushPrimaryText" Color="#17213A" />
    <SolidColorBrush x:Key="BrushSecondaryText" Color="#687791" />
    <SolidColorBrush x:Key="BrushMutedText" Color="#8E9DAE" />

    <!-- Borders and Dividers -->
    <SolidColorBrush x:Key="BrushBorder" Color="#D8E2F2" />
    <SolidColorBrush x:Key="BrushSubtleBorder" Color="#E5EDF7" />

    <!-- Shadow Color -->
    <Color x:Key="ColorShadow">#7C8EA8</Color>

</ResourceDictionary>
