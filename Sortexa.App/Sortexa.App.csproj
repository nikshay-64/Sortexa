<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sortexa.Core\Sortexa.Core.csproj" />
    <ProjectReference Include="..\Sortexa.Infrastructure\Sortexa.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Sortexa.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Sortexa.ico</ApplicationIcon>
    <AssemblyName>Sortexa</AssemblyName>
    <Product>Sortexa</Product>
    <Title>Sortexa</Title>
    <Description>Premium Windows Desktop File Organizer</Description>
    <Company>Nikshay Kumar</Company>
    <Authors>Nikshay Kumar</Authors>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
