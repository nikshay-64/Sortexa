<Window x:Class="Sortexa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Sortexa.App.ViewModels"
        xmlns:views="clr-namespace:Sortexa.App.Views"
        mc:Ignorable="d"
        Title="Sortexa - File Organizer"
        Icon="Assets/Sortexa.ico"
        Width="1200" Height="800"
        MinWidth="950" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}">

    <Window.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MethodSelectionViewModel}">
            <views:MethodSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MethodConfigViewModel}">
            <views:MethodConfigView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <views:PreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}">
            <views:ProgressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompletionViewModel}">
            <views:CompletionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <views:CategoriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>

        <!-- Navigation Button Template -->
        <ControlTemplate x:Key="NavButtonTemplate" TargetType="Button">
            <Border x:Name="NavBorder"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path x:Name="NavIcon"
                          Grid.Column="0"
                          Data="{TemplateBinding Tag}"
                          Fill="{DynamicResource BrushSecondaryText}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center" />

                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />

                    <!-- Active Indicator Pill -->
                    <Border x:Name="ActivePill"
                            Grid.Column="2"
                            Width="4" Height="16"
                            CornerRadius="2"
                            Background="{StaticResource BrushNavIndicatorGradient}"
                            Visibility="Collapsed" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource BrushHoverSurface}" />
                    <Setter TargetName="NavIcon" Property="Fill" Value="{StaticResource BrushCyan}" />
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}, Path=IsEnabled}" Value="False">
                    <Setter TargetName="NavBorder" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BrushBackground}">
        <Grid.ColumnDefinitions>
            <!-- Navigation Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Canvas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Region -->
        <Border Grid.Column="0"
                Background="{DynamicResource BrushSecondaryBackground}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,1,0"
                Padding="16,20,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Wordmark Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*" />
                    <!-- Footer Actions -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,0,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushPrimaryGradient}" Margin="0,0,10,0">
                            <Path Data="{StaticResource GeoSortexaLogo}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SORTEXA"
                                       FontFamily="{StaticResource FontDisplay}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushPrimaryText}" />
                            <TextBlock Text="Desktop Organizer"
                                       Style="{StaticResource StyleCaption}"
                                       Foreground="{DynamicResource BrushMutedText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links List -->
                <StackPanel Grid.Row="1">

                    <!-- Dashboard -->
                    <Button Command="{Binding NavigateDashboardCommand}"
                            Tag="{StaticResource GeoFolder}"
                            Template="{StaticResource NavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
                                <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Dashboard">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushElectricBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Dashboard" />
                    </Button>

                    <!-- History -->
                    <Button Command="{Binding NavigateHistoryCommand}"
                            Tag="{StaticResource GeoHistory}"
                            Template="{StaticResource NavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
                                <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="History">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushElectricBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="History &amp; Undo" />
                    </Button>

                    <!-- Categories -->
                    <Button Command="{Binding NavigateCategoriesCommand}"
                            Tag="{StaticResource GeoLayers}"
                            Template="{StaticResource NavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
                                <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Categories">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushElectricBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Categories" />
                    </Button>

                    <!-- Settings -->
                    <Button Command="{Binding NavigateSettingsCommand}"
                            Tag="{StaticResource GeoSettings}"
                            Template="{StaticResource NavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
                                <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushElectricBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Settings" />
                    </Button>

                    <!-- About -->
                    <Button Command="{Binding NavigateAboutCommand}"
                            Tag="{StaticResource GeoInfo}"
                            Template="{StaticResource NavButtonTemplate}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
                                <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="About">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushElectricBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="About Sortexa" />
                    </Button>

                </StackPanel>

                <!-- Footer: Theme Toggle & Version -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Theme Toggle Button -->
                        <Button Grid.Column="0"
                                Style="{StaticResource StyleGhostButton}"
                                Command="{Binding ToggleThemeCommand}"
                                HorizontalAlignment="Left"
                                Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSun}" Fill="{StaticResource BrushAmber}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentTheme, StringFormat='Theme: {0}'}" Style="{StaticResource StyleCaption}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Text="v1.0.0" Style="{StaticResource StyleCaption}" Foreground="{DynamicResource BrushMutedText}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource StoryboardPageEnter}" />
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

    </Grid>
</Window>
