<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Action Gradient (Blue to Violet) -->
    <LinearGradientBrush x:Key="BrushPrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3987FF" Offset="0.0" />
        <GradientStop Color="#635BFF" Offset="0.5" />
        <GradientStop Color="#A855F7" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Highlight Gradient (Cyan to Electric Blue) -->
    <LinearGradientBrush x:Key="BrushHighlightGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#20D9F3" Offset="0.0" />
        <GradientStop Color="#3987FF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Hero Panel Gradient (Indigo to Violet to Magenta) -->
    <LinearGradientBrush x:Key="BrushHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#635BFF" Offset="0.0" />
        <GradientStop Color="#A855F7" Offset="0.5" />
        <GradientStop Color="#EC4899" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Success Emerald Gradient -->
    <LinearGradientBrush x:Key="BrushSuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#20C997" Offset="0.0" />
        <GradientStop Color="#10B981" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Amber Warning Gradient -->
    <LinearGradientBrush x:Key="BrushAmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB547" Offset="0.0" />
        <GradientStop Color="#F59E0B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Danger/Coral Accent Gradient -->
    <LinearGradientBrush x:Key="BrushDangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6B81" Offset="0.0" />
        <GradientStop Color="#EC4899" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Selected Navigation Gradient -->
    <LinearGradientBrush x:Key="BrushNavIndicatorGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20D9F3" Offset="0.0" />
        <GradientStop Color="#3987FF" Offset="0.5" />
        <GradientStop Color="#A855F7" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glassmorphic Card Border Stroke -->
    <LinearGradientBrush x:Key="BrushGlassBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#503987FF" Offset="0.0" />
        <GradientStop Color="#3020D9F3" Offset="0.5" />
        <GradientStop Color="#40A855F7" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Selected Card Glow Border -->
    <LinearGradientBrush x:Key="BrushSelectedCardBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3987FF" Offset="0.0" />
        <GradientStop Color="#FF20D9F3" Offset="0.5" />
        <GradientStop Color="#FFA855F7" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Subtle Ambient Splash Glow -->
    <RadialGradientBrush x:Key="BrushAmbientSplashGlow" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#353987FF" Offset="0.0" />
        <GradientStop Color="#20635BFF" Offset="0.4" />
        <GradientStop Color="#10A855F7" Offset="0.7" />
        <GradientStop Color="#00000000" Offset="1.0" />
    </RadialGradientBrush>

</ResourceDictionary>
