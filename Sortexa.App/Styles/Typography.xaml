<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- Header Style -->
    <Style x:Key="StyleHeaderLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
    </Style>

    <Style x:Key="StyleHeaderMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
    </Style>

    <Style x:Key="StyleHeaderSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
    </Style>

    <!-- Subtitle Style -->
    <Style x:Key="StyleSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryText}" />
    </Style>

    <!-- Body Style -->
    <Style x:Key="StyleBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryText}" />
    </Style>

    <Style x:Key="StyleBodySecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource BrushSecondaryText}" />
    </Style>

    <Style x:Key="StyleCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMutedText}" />
    </Style>

    <Style x:Key="StyleCode" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource BrushCyan}" />
    </Style>

</ResourceDictionary>
