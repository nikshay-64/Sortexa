<UserControl x:Class="Sortexa.App.Views.MethodConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Sortexa.Core.Models;assembly=Sortexa.Core"
             xmlns:converters="clr-namespace:Sortexa.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="950">

    <UserControl.Resources>
        <converters:EnumBooleanConverter x:Key="ConvYearMonth" TargetValue="YearMonth" />
        <converters:EnumBooleanConverter x:Key="ConvYearMonthDay" TargetValue="YearMonthDay" />
        <converters:EnumBooleanConverter x:Key="ConvYearOnly" TargetValue="YearOnly" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <Button Style="{StaticResource StyleGhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Padding="4,4">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoArrowLeft}" Fill="{DynamicResource BrushSecondaryText}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Back to Strategy Selection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding MethodTitle}" Style="{StaticResource StyleHeaderLarge}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding MethodDescription}" Style="{StaticResource StyleSubtitle}" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Configuration Panels (Dynamic based on selected method) -->
            <StackPanel Grid.Row="1">

                <!-- Date Grouping Options Panel -->
                <Border Style="{StaticResource StyleCard}" Margin="0,0,0,20" Visibility="{Binding IsDateConfigVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Date Hierarchy Format" Style="{StaticResource StyleHeaderSmall}" Margin="0,0,0,6" />
                        <TextBlock Text="Choose how deeply timestamp folders should be structured:" Style="{StaticResource StyleBodySecondary}" Margin="0,0,0,14" />

                        <StackPanel Margin="0,0,0,16">
                            <RadioButton GroupName="DateFmt" Content="Year and Month (e.g., 2026\10 - October)"
                                         IsChecked="{Binding DateFormat, Mode=TwoWay, Converter={StaticResource ConvYearMonth}}"
                                         Margin="0,0,0,10" Style="{StaticResource StyleRadioButton}" />

                            <RadioButton GroupName="DateFmt" Content="Year, Month, and Day (e.g., 2026\10 - October\14)"
                                         IsChecked="{Binding DateFormat, Mode=TwoWay, Converter={StaticResource ConvYearMonthDay}}"
                                         Margin="0,0,0,10" Style="{StaticResource StyleRadioButton}" />

                            <RadioButton GroupName="DateFmt" Content="Year Only (e.g., 2026)"
                                         IsChecked="{Binding DateFormat, Mode=TwoWay, Converter={StaticResource ConvYearOnly}}"
                                         Style="{StaticResource StyleRadioButton}" />
                        </StackPanel>

                        <!-- Informational Alert -->
                        <Border Background="{DynamicResource BrushHoverSurface}" CornerRadius="8" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoInfo}" Fill="{StaticResource BrushCyan}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Note: On Windows, copying or downloading a file sets its filesystem creation timestamp to the moment of download."
                                           Style="{StaticResource StyleCaption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- File Extensions Options Panel -->
                <Border Style="{StaticResource StyleCard}" Margin="0,0,0,20" Visibility="{Binding IsExtensionConfigVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Extension Grouping Rules" Style="{StaticResource StyleHeaderSmall}" Margin="0,0,0,12" />

                        <CheckBox Content="Group files without an extension into 'No Extension'"
                                  IsChecked="{Binding GroupExtensionless, Mode=TwoWay}"
                                  Style="{StaticResource StyleCheckBox}"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="Rare Extension Threshold (Optional)" Style="{StaticResource StyleBody}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Extensions with fewer files than this count will be grouped into 'Other Extensions' (0 to disable):" Style="{StaticResource StyleBodySecondary}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding ExtensionThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleTextBox}" Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Custom Rules Builder Panel -->
                <Border Style="{StaticResource StyleCard}" Margin="0,0,0,20" Visibility="{Binding IsCustomRulesConfigVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Custom Rule Builder" Style="{StaticResource StyleHeaderSmall}" Margin="0,0,0,8" />
                        <TextBlock Text="Rules are evaluated in ascending priority order. First matching rule determines target subfolder." Style="{StaticResource StyleBodySecondary}" Margin="0,0,0,16" />

                        <!-- Form row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Rule Name" Style="{StaticResource StyleCaption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Field" Style="{StaticResource StyleCaption}" Margin="0,0,0,4" />
                                <ComboBox SelectedItem="{Binding NewRuleField}" Style="{StaticResource StyleComboBox}">
                                    <models:RuleConditionField>FileNameContains</models:RuleConditionField>
                                    <models:RuleConditionField>FileNamePrefix</models:RuleConditionField>
                                    <models:RuleConditionField>FileNameSuffix</models:RuleConditionField>
                                    <models:RuleConditionField>Extension</models:RuleConditionField>
                                    <models:RuleConditionField>FileNameRegex</models:RuleConditionField>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Operator" Style="{StaticResource StyleCaption}" Margin="0,0,0,4" />
                                <ComboBox SelectedItem="{Binding NewRuleOperator}" Style="{StaticResource StyleComboBox}">
                                    <models:RuleConditionOperator>Contains</models:RuleConditionOperator>
                                    <models:RuleConditionOperator>StartsWith</models:RuleConditionOperator>
                                    <models:RuleConditionOperator>EndsWith</models:RuleConditionOperator>
                                    <models:RuleConditionOperator>Equals</models:RuleConditionOperator>
                                    <models:RuleConditionOperator>MatchesRegex</models:RuleConditionOperator>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Match Value" Style="{StaticResource StyleCaption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewRuleValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Text="Subfolder" Style="{StaticResource StyleCaption}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewRuleTargetFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleTextBox}" />
                            </StackPanel>

                            <Button Grid.Column="5" Style="{StaticResource StylePrimaryButton}" Command="{Binding AddRuleCommand}" VerticalAlignment="Bottom" Padding="14,9">
                                <TextBlock Text="+ Add Rule" />
                            </Button>
                        </Grid>

                        <!-- Active Rules List -->
                        <TextBlock Text="Active Rules:" Style="{StaticResource StyleBody}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding CustomRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushHoverSurface}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" Style="{StaticResource StyleBody}" Margin="0,0,12,0" />
                                                <TextBlock Text="When " Style="{StaticResource StyleCaption}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Field}" Foreground="{StaticResource BrushCyan}" Style="{StaticResource StyleCaption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Operator}" Style="{StaticResource StyleCaption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding Value, StringFormat='&quot;{0}&quot;'}" Foreground="{StaticResource BrushAmber}" Style="{StaticResource StyleCaption}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <TextBlock Text="Move to: " Style="{StaticResource StyleCaption}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TargetSubfolder}" Foreground="{StaticResource BrushEmerald}" Style="{StaticResource StyleCaption}" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource StyleGhostButton}"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4">
                                                <Path Data="{StaticResource GeoTrash}" Fill="{StaticResource BrushCoral}" Width="12" Height="12" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- General Fallback Folder Card -->
                <Border Style="{StaticResource StyleCard}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Unmatched / Fallback Subfolder" Style="{StaticResource StyleBody}" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Text="Files that do not match any specified rule or category will be placed into this folder." Style="{StaticResource StyleCaption}" />
                        </StackPanel>

                        <TextBox Grid.Column="1" Text="{Binding FallbackFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleTextBox}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </StackPanel>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Style="{StaticResource StyleCard}" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Sortexa will analyze your files and build a pre-flight execution plan." Style="{StaticResource StyleSubtitle}" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Style="{StaticResource StylePrimaryButton}" Command="{Binding ContinueCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Generate Preview Plan" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Path Data="{StaticResource GeoArrowRight}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
