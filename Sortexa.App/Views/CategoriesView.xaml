<UserControl x:Class="Sortexa.App.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Sortexa.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="950">

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Category Manager" Style="{StaticResource StyleHeaderLarge}" Margin="0,0,0,6" />
                <TextBlock Text="Manage extension mappings and categories used by the Smart Categories engine." Style="{StaticResource StyleSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource StyleSecondaryButton}" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,10,0">
                    <TextBlock Text="Restore Defaults" />
                </Button>
                <Button Style="{StaticResource StylePrimaryButton}" Command="{Binding SaveChangesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoSave}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Save Changes" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Master / Detail Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Master Category List -->
            <Border Grid.Column="0" Style="{StaticResource StyleCard}" Padding="12">
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushHoverSurface}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushElevatedSurface}" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrushElectricBlue}" />
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Accent Dot -->
                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding AccentColor}" Margin="0,0,10,0" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource StyleBody}" FontWeight="SemiBold" VerticalAlignment="Center" />

                                <!-- Extension count badge -->
                                <Border Grid.Column="2" Background="{DynamicResource BrushInputBackground}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding Extensions.Count}" Style="{StaticResource StyleCaption}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Detail Editor Panel -->
            <Border Grid.Column="2" Style="{StaticResource StyleCard}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Category Title & Enable Checkbox -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedCategory.DisplayName}" Style="{StaticResource StyleHeaderMedium}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedCategory.Description}" Style="{StaticResource StyleSubtitle}" />
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  Content="Category Enabled"
                                  IsChecked="{Binding SelectedCategory.IsEnabled, Mode=TwoWay}"
                                  Style="{StaticResource StyleCheckBox}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <!-- Add Extension Box -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushHoverSurface}" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewExtensionText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyleTextBox}"
                                     Margin="0,0,10,0" />

                            <TextBlock Grid.Column="0"
                                       Text="Type an extension to add (e.g., .doc or .png)..."
                                       Style="{StaticResource StyleCaption}"
                                       Foreground="{DynamicResource BrushMutedText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding NewExtensionText.Length, Converter={x:Static converters:EmptyStringToVisibilityConverter.Instance}, FallbackValue=Visible}" />

                            <Button Grid.Column="1" Style="{StaticResource StylePrimaryButton}" Command="{Binding AddExtensionCommand}" Padding="14,8">
                                <TextBlock Text="+ Add Extension" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Extensions Section Header -->
                    <TextBlock Grid.Row="2" Text="Associated Extensions:" Style="{StaticResource StyleBody}" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- Extension Tags WrapPanel -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedCategory.Extensions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushInputBackground}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Style="{StaticResource StyleCode}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource StyleGhostButton}"
                                                    Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,2">
                                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource BrushCoral}" FontWeight="Bold" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Status Feedback Text -->
                    <Border Grid.Row="4" Background="{DynamicResource BrushHoverSurface}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0"
                            Visibility="{Binding StatusFeedback, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding StatusFeedback}" Style="{StaticResource StyleBodySecondary}" Foreground="{StaticResource BrushCyan}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
