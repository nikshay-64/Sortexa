<UserControl x:Class="Sortexa.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="32,48,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Centered Progress Card Container (Fixed 680px width so box never jumps or resizes) -->
        <Border Style="{StaticResource StyleGlassCard}"
                Width="680"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="36">
            <StackPanel>

                <!-- Processing Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Organizing Files..." Style="{StaticResource StyleHeaderLarge}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StyleSubtitle}" TextTrimming="CharacterEllipsis" Height="20" />
                    </StackPanel>

                    <!-- Percentage Indicator -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushHoverSurface}" CornerRadius="10" Padding="14,6" VerticalAlignment="Center" MinWidth="84">
                        <!-- Strict Mode=OneWay binding on read-only Percentage property -->
                        <TextBlock Text="{Binding Percentage, Mode=OneWay, StringFormat='{}{0:F0}%'}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushCyan}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Animated ProgressBar with STRICT Mode=OneWay Binding -->
                <ProgressBar Style="{StaticResource StyleProgressBar}"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Percentage, Mode=OneWay}"
                             Height="12"
                             Margin="0,0,0,20" />

                <!-- Current Active File Label (Fixed 42px height with clean character ellipsis) -->
                <Border Background="{DynamicResource BrushInputBackground}" CornerRadius="8" Padding="14,10" Margin="0,0,0,24" Height="42">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Current File: " Style="{StaticResource StyleCaption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentFile}" Style="{StaticResource StyleCode}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!-- Metric Counters Row (Fixed 68px height cards) -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StyleStatCard}" Margin="0,0,8,0" Height="68">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Progress" Style="{StaticResource StyleCaption}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource StyleHeaderSmall}" HorizontalAlignment="Center">
                                <Run Text="{Binding ProcessedCount, Mode=OneWay}" />
                                <Run Text="/" Foreground="{DynamicResource BrushMutedText}" />
                                <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{DynamicResource BrushMutedText}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StyleStatCard}" Margin="0,0,8,0" Height="68">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Organized" Style="{StaticResource StyleCaption}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding MovedCount, Mode=OneWay}" Style="{StaticResource StyleHeaderSmall}" Foreground="{StaticResource BrushEmerald}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StyleStatCard}" Margin="0,0,8,0" Height="68">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Skipped" Style="{StaticResource StyleCaption}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SkippedCount, Mode=OneWay}" Style="{StaticResource StyleHeaderSmall}" Foreground="{StaticResource BrushAmber}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StyleStatCard}" Height="68">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Failed" Style="{StaticResource StyleCaption}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FailedCount, Mode=OneWay}" Style="{StaticResource StyleHeaderSmall}" Foreground="{StaticResource BrushCoral}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Cancellation Action -->
                <Button Style="{StaticResource StyleDangerButton}"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Center"
                        Padding="24,10">
                    <TextBlock Text="Stop &amp; Cancel Safely" />
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
