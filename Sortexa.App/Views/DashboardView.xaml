<UserControl x:Class="Sortexa.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero Welcome Card -->
            <Border Grid.Row="0" Style="{StaticResource StyleHeroCard}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome to Sortexa" Style="{StaticResource StyleHeaderLarge}" Margin="0,0,0,8" />
                        <TextBlock Text="Sort, structure, and declutter any folder with deterministic safety, pre-flight previews, and instant Undo."
                                   Style="{StaticResource StyleSubtitle}"
                                   TextWrapping="Wrap"
                                   MaxWidth="580"
                                   HorizontalAlignment="Left" />

                        <!-- 3-Step Process Flow -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BrushHoverSurface}" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource BrushElectricBlue}" Margin="0,0,8,0">
                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Pick Folder" Style="{StaticResource StyleBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Path Grid.Column="1" Data="{StaticResource GeoArrowRight}" Stroke="{DynamicResource BrushMutedText}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />

                            <Border Grid.Column="2" Background="{DynamicResource BrushHoverSurface}" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource BrushIndigo}" Margin="0,0,8,0">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Select Method" Style="{StaticResource StyleBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Path Grid.Column="3" Data="{StaticResource GeoArrowRight}" Stroke="{DynamicResource BrushMutedText}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />

                            <Border Grid.Column="4" Background="{DynamicResource BrushHoverSurface}" CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource BrushEmerald}" Margin="0,0,8,0">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Preview &amp; Organize" Style="{StaticResource StyleBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Decorative Graphic Badge -->
                    <Border Grid.Column="1" Width="80" Height="80" CornerRadius="40" Background="{StaticResource BrushPrimaryGradient}" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#3987FF" BlurRadius="20" Opacity="0.4" ShadowDepth="0" />
                        </Border.Effect>
                        <Path Data="{StaticResource GeoSortexaLogo}" Fill="White" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Drag & Drop / Selection Drop Zone -->
            <Border x:Name="DropZone"
                    Grid.Row="1"
                    Style="{StaticResource StyleGlassCard}"
                    Padding="32"
                    AllowDrop="True"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop"
                    Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Icon badge -->
                    <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource BrushHoverSurface}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="{StaticResource GeoFolder}" Fill="{StaticResource BrushElectricBlue}" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Choose a folder to organize" Style="{StaticResource StyleHeaderMedium}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Drag and drop your messy folder here, or click Browse to select" Style="{StaticResource StyleSubtitle}" HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource StylePrimaryButton}" Command="{Binding PickFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoFolder}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Browse Folder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Selected Folder Info Card -->
            <Border Grid.Row="2" Style="{StaticResource StyleCard}" Margin="0,0,0,24" Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Selected Target Folder" Style="{StaticResource StyleCaption}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedFolderPath}" Style="{StaticResource StyleCode}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StyleStatCard}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoFileText}" Fill="{StaticResource BrushCyan}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileCount, StringFormat='{}{0} Files Found'}" Style="{StaticResource StyleBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StyleStatCard}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoBarChart2}" Fill="{StaticResource BrushViolet}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FormattedSize, StringFormat='{}Total Size: {0}'}" Style="{StaticResource StyleBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Style="{StaticResource StyleSecondaryButton}" Command="{Binding PickFolderCommand}" Margin="0,0,0,8">
                                <TextBlock Text="Change Folder" />
                            </Button>
                            <Button Style="{StaticResource StyleGhostButton}" Command="{Binding ClearFolderCommand}">
                                <TextBlock Text="Clear Selection" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Scanning / Ready Status -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushHoverSurface}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoCheckCircle}" Fill="{StaticResource BrushEmerald}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StyleBodySecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Bottom Navigation Action Bar -->
            <Grid Grid.Row="3" Margin="0,8,0,0" Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Next: Pick your preferred organization strategy" Style="{StaticResource StyleSubtitle}" VerticalAlignment="Center" />

                <Button Grid.Column="1" Style="{StaticResource StylePrimaryButton}" Command="{Binding ContinueCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Continue to Method Selection" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Path Data="{StaticResource GeoArrowRight}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
