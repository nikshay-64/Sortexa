<UserControl x:Class="Sortexa.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <!-- A. Page Header -->
                <RowDefinition Height="Auto" />
                <!-- B. Product Identity Hero Banner -->
                <RowDefinition Height="Auto" />
                <!-- C. Product Description Section -->
                <RowDefinition Height="Auto" />
                <!-- D. Developer & Technical Information -->
                <RowDefinition Height="Auto" />
                <!-- E. Product and Copyright Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- A. Page Header (matches Dashboard & Settings tabs) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="About Sortexa" Style="{StaticResource StyleHeaderLarge}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Tagline}" Style="{StaticResource StyleSubtitle}" />
            </StackPanel>

            <!-- B. Product Identity Hero Banner (full-width hero card) -->
            <Border Grid.Row="1" Style="{StaticResource StyleHeroCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Luminous Brand Logo Emblem -->
                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="20" Background="{StaticResource BrushPrimaryGradient}" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#3987FF" BlurRadius="22" Opacity="0.45" ShadowDepth="0" />
                        </Border.Effect>
                        <Path Data="{StaticResource GeoSortexaLogo}" Fill="White" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Identity Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding AppName}" FontFamily="{StaticResource FontDisplay}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryText}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <Border Background="{StaticResource BrushHighlightGradient}" CornerRadius="10" Padding="12,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version, StringFormat='v{0} (Release Build)'}" Foreground="White" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Tagline}" Style="{StaticResource StyleSubtitle}" Foreground="{DynamicResource BrushSecondaryText}" FontWeight="Medium" Margin="0,0,0,6" />
                        <TextBlock Text="Desktop File Organizer for Windows 10 &amp; 11 (x64)" Style="{StaticResource StyleCaption}" Foreground="{DynamicResource BrushMutedText}" />
                    </StackPanel>

                    <!-- Feature Badges -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                        <Border Background="{DynamicResource BrushHoverSurface}" CornerRadius="8" Padding="12,6" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoCheckCircle}" Fill="{StaticResource BrushEmerald}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="100% Private &amp; Offline" Style="{StaticResource StyleCaption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushHoverSurface}" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSparkles}" Fill="{StaticResource BrushCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Deterministic Safety" Style="{StaticResource StyleCaption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- C. Product Description Section (Full-width, theme-consistent surface) -->
            <Border Grid.Row="2" Style="{StaticResource StyleCard}" Margin="0,0,0,20" Padding="24">
                <StackPanel>
                    <TextBlock Text="PRODUCT OVERVIEW" Style="{StaticResource StyleCaption}" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding ProductDescription}"
                               Style="{StaticResource StyleBody}"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Foreground="{DynamicResource BrushPrimaryText}" />
                </StackPanel>
            </Border>

            <!-- D. Developer Information (Two-Column Balanced Section across content width) -->
            <Grid Grid.Row="3" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Lead Architect & Developer Card -->
                <Border Grid.Column="0" Style="{StaticResource StyleElevatedCard}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="LEAD SOFTWARE ARCHITECT &amp; DEVELOPER" Style="{StaticResource StyleCaption}" FontWeight="Bold" Foreground="{StaticResource BrushCyan}" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding DeveloperName}"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushPrimaryText}"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{Binding DeveloperDepartment}"
                                   Style="{StaticResource StyleBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushSecondaryText}"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{Binding DeveloperInstitution}"
                                   Style="{StaticResource StyleBodySecondary}"
                                   Foreground="{DynamicResource BrushMutedText}"
                                   Margin="0,0,0,16" />

                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,0,0,14" />

                        <TextBlock Text="{Binding MadeWithLoveAttribution}"
                                   FontFamily="{StaticResource FontBody}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushMagenta}" />
                    </StackPanel>
                </Border>

                <!-- Right Card: Technical Architecture & Standards -->
                <Border Grid.Column="2" Style="{StaticResource StyleCard}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="TECHNICAL ARCHITECTURE" Style="{StaticResource StyleCaption}" FontWeight="Bold" Foreground="{StaticResource BrushElectricBlue}" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Framework:" Style="{StaticResource StyleCaption}" Foreground="{DynamicResource BrushMutedText}" />
                            <TextBlock Grid.Column="1" Text=".NET 10 (net10.0-windows) / WPF" Style="{StaticResource StyleCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Architecture:" Style="{StaticResource StyleCaption}" Foreground="{DynamicResource BrushMutedText}" />
                            <TextBlock Grid.Column="1" Text="Layered MVVM with Dependency Injection" Style="{StaticResource StyleCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Safety Engine:" Style="{StaticResource StyleCaption}" Foreground="{DynamicResource BrushMutedText}" />
                            <TextBlock Grid.Column="1" Text="Transactional Journaling &amp; SHA-256 Verification" Style="{StaticResource StyleCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target OS:" Style="{StaticResource StyleCaption}" Foreground="{DynamicResource BrushMutedText}" />
                            <TextBlock Grid.Column="1" Text="Windows 10 &amp; Windows 11 (x64)" Style="{StaticResource StyleCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryText}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- E. Product & Copyright Information (aligned at footer) -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <TextBlock Text="{Binding LicenseInfo}"
                           Style="{StaticResource StyleCaption}"
                           Foreground="{DynamicResource BrushMutedText}"
                           HorizontalAlignment="Center" />
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
