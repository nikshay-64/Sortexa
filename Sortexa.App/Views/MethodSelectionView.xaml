<UserControl x:Class="Sortexa.App.Views.MethodSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <Button Style="{StaticResource StyleGhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Padding="4,4">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoArrowLeft}" Fill="{DynamicResource BrushSecondaryText}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Back to Folder Selection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Choose Organization Strategy" Style="{StaticResource StyleHeaderLarge}" Margin="0,0,0,6" />
                <TextBlock Text="Select how you want Sortexa to group your files. You will preview all proposed moves before anything changes."
                           Style="{StaticResource StyleSubtitle}" />
            </StackPanel>

            <!-- 7 Method Cards Grid -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Methods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="410" Margin="0,0,18,18"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding DataContext.SelectMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StyleCard}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushSelectedCardBorder}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Background" Value="{DynamicResource BrushElevatedSurface}" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#3987FF" BlurRadius="18" Opacity="0.4" ShadowDepth="4" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon Container -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource BrushHoverSurface}" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoLayers}"
                                          Fill="{Binding AccentColor}"
                                          Width="22" Height="22"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource StyleHeaderSmall}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource StyleBodySecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <Border Background="{DynamicResource BrushInputBackground}" CornerRadius="6" Padding="8,5" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Example: " Style="{StaticResource StyleCaption}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExampleStructure}" Style="{StaticResource StyleCaption}" FontFamily="{StaticResource FontMono}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Radio Indicator -->
                                <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11" BorderThickness="2" VerticalAlignment="Top" Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushElectricBlue}" />
                                                    <Setter Property="Background" Value="{StaticResource BrushElectricBlue}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Ellipse Width="8" Height="8" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Style="{StaticResource StyleCard}" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCard.Title, StringFormat='Selected Strategy: {0}'}" Style="{StaticResource StyleBody}" FontWeight="SemiBold" />
                        <TextBlock Text="Next step: Configure options and preview the proposed plan." Style="{StaticResource StyleCaption}" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource StylePrimaryButton}" Command="{Binding ContinueCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Configure &amp; Preview Plan" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Path Data="{StaticResource GeoArrowRight}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
